# ---- Build stage ----
FROM node:18-alpine AS builder
WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --legacy-peer-deps

# Copy source
COPY . .

# Build-time env variables
ARG NEXT_PUBLIC_LOGIN_API_URL
ARG NEXT_PUBLIC_REGISTER_API_URL
ARG NEXT_PUBLIC_RETRIEVAL_API_URL
ARG NEXT_PUBLIC_UPDATE_FOLDERS_API_URL
ARG NEXT_PUBLIC_SELECT_DATE_URL
ARG NEXT_PUBLIC_GET_PPTS_URL
ARG NEXT_PUBLIC_LIST_PDFS_API_URL
ARG NEXT_PUBLIC_DOWNLOAD_PDF_API_URL
ARG NEXT_PUBLIC_CHAT_API_URL

# Pass to build
ENV NEXT_PUBLIC_LOGIN_API_URL=$NEXT_PUBLIC_LOGIN_API_URL \
    NEXT_PUBLIC_REGISTER_API_URL=$NEXT_PUBLIC_REGISTER_API_URL \
    NEXT_PUBLIC_RETRIEVAL_API_URL=$NEXT_PUBLIC_RETRIEVAL_API_URL \
    NEXT_PUBLIC_UPDATE_FOLDERS_API_URL=$NEXT_PUBLIC_UPDATE_FOLDERS_API_URL \
    NEXT_PUBLIC_SELECT_DATE_URL=$NEXT_PUBLIC_SELECT_DATE_URL \
    NEXT_PUBLIC_GET_PPTS_URL=$NEXT_PUBLIC_GET_PPTS_URL \
    NEXT_PUBLIC_LIST_PDFS_API_URL=$NEXT_PUBLIC_LIST_PDFS_API_URL \
    NEXT_PUBLIC_DOWNLOAD_PDF_API_URL=$NEXT_PUBLIC_DOWNLOAD_PDF_API_URL \
    NEXT_PUBLIC_CHAT_API_URL=$NEXT_PUBLIC_CHAT_API_URL

# Increase Node memory for build
ENV NODE_OPTIONS=--max-old-space-size=4096

# Build Next.js
RUN npm run build

# ---- Production stage ----
FROM node:18-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Copy build artifacts
COPY --from=builder /app/ ./

# Expose port
EXPOSE 3000

# Run Next.js and bind to 0.0.0.0 so Docker exposes it
CMD ["npx", "next", "start", "-p", "3000", "-H", "0.0.0.0"]
